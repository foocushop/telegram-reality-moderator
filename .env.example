# ==============================================================================
# CONFIGURATION DU BOT TELEGRAM MODÉRATEUR TÉLÉ-RÉALITÉ (100% GRATUIT)
# ==============================================================================

# 1. TOKEN TELEGRAM DU BOT (Obligatoire, 100% Gratuit)
# Obtenez-le en 30 secondes en ouvrant une conversation avec @BotFather sur Telegram
# Tapez /newbot, donnez-lui un nom, et copiez le token ici.
TELEGRAM_BOT_TOKEN=VOTRE_TOKEN_TELEGRAM_ICI

# 2. CLÉ API GOOGLE GEMINI (100% Gratuit sur https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=VOTRE_CLE_GEMINI_ICI

# 2.BIS ALTERNATIVE GRATUITE GROQ (Optionnel, si Google bloque votre compte : https://console.groq.com)
GROQ_API_KEY=

# Modèle d'IA utilisé (gemini-3.6-flash est le plus rapide, gratuit et performant pour la vision)
GEMINI_MODEL=gemini-3.6-flash

# 3. PARAMÈTRES DES SANCTIONS
# Durée de la mise en sourdine (mute) pour insultes légères en minutes (ex: 15)
MUTE_DURATION_MINUTES=15

# Supprimer automatiquement les messages qui violent les règles (true / false)
DELETE_OFFENDING_MESSAGES=true

# Annoncer publiquement la sanction dans le chat avec les détails (true / false)
NOTIFY_CHAT_ON_ACTION=true

# 4. ADMINISTRATEURS DU GROUPE
# ID Telegram des administrateurs protégés contre toute sanction (séparés par des virgules)
# Pour trouver votre ID, écrivez à @userinfobot sur Telegram.
ADMIN_USER_IDS=

# 5. PERSONNALITÉ ET CONTEXTE DU BOT
# Définissez ici le rôle et la manière dont le bot doit répondre aux membres
BOT_PERSONALITY_CONTEXT="Tu es Léna (Léna Situations, @Lenasituation_bot), l'animatrice complice et modératrice bienveillante de ce groupe Télé-Réalité. Ambiance solaire, décontractée, positive (+ = +). Expressions discrètes au moment propice, réponses courtes (1 à 2 phrases max) et chaleureuses."

# Taux de réponse spontanée sans être mentionné (0 = répond uniquement si tagué, 0.05 = 5% de chance)
SPONTANEOUS_REPLY_RATE=0

# Mode test/simulation sans appel réel aux API (true / false)
MOCK_MODE=false
